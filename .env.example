# Copy to .env for Docker Compose overrides. Service URLs are resolved inside Docker.
MODEL_PORT=8000
ESTIMATOR_PORT=8001
MARKET_PORT=8002
WEB_PORT=3000
APP_ENVIRONMENT=Testing
APP_VERSION=0.0.1
MODEL_API_URL=http://housing-model-api:8000
ESTIMATOR_API_URL=http://estimator-api:8001
MARKET_API_URL=http://market-api:8002
MODEL_TIMEOUT_SECONDS=10
MODEL_TIMEOUT_MS=10000
API_TIMEOUT_MS=15000
# Set the browser-accessible Swagger URL here, especially when MODEL_PORT changes.
MODEL_DOCS_URL=http://localhost:8000/docs
